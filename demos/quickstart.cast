[0.000, "o", "  vaultic — local-first password manager\r\n════════════════════════════════════════════\r\n"]
[1.507, "o", "\r\n\u001b[1;32m$\u001b[0m vaultic init --name 'Demo Vault' --password 'demo-password-123!'\r\n"]
